{
  "redirects": [
    {
      "source": "/invite/(.*)",
      "destination": "https://www.shakeapp.today/invite/$1",
      "permanent": false
    },
    {
      "source": "/guest/(.*)",
      "destination": "https://www.shakeapp.today/guest/$1",
      "permanent": false
    },
    {
      "source": "/:code([a-zA-Z0-9]+-[a-zA-Z0-9]+)",
      "destination": "https://www.shakeapp.today/:code",
      "permanent": false
    }
  ]
}
